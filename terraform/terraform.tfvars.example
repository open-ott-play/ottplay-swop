# For TFC remote runs set workspace variables: account, email, key (key = sensitive).
# Local overrides (gitignored): copy to terraform.tfvars or pass -var / TF_VAR_account etc.
account = "YOUR_CLOUDFLARE_ACCOUNT_ID"
email   = "you@example.com"
key     = "YOUR_GLOBAL_API_KEY"
