{
  "version_file": "package.json",
  "validation_workflows": [
    "ci.yml",
    "codeql.yml",
    "dependency-review.yml"
  ],
  "artifact_pattern": "release-assets*",
  "local_checks": [
    "npm ci --ignore-scripts",
    "npm run typecheck",
    "npm test",
    "bash scripts/release-build.sh \"$(node -p 'require(\"./package.json\").version')\" beta",
    "terraform -chdir=terraform fmt -check",
    "terraform -chdir=terraform init -backend=false",
    "terraform -chdir=terraform validate"
  ],
  "notes": [
    "Worker bundle is packaged using example configuration; production account bindings and credentials are never embedded.",
    "Cloudflare deployment is explicit and must use the archived worker.js; promotion itself does not deploy.",
    "Worker API unit tests are required by CI and local release checks before candidate packaging."
  ],
  "repository": "open-ott-play/ottplay-swop",
  "mode": "release",
  "default_branch": "main",
  "visibility": "public",
  "versioning": {
    "schema": 1,
    "promotion": "promote-bytes",
    "files": [
      {
        "path": "package.json",
        "format": "json",
        "value": "package",
        "field": "version"
      },
      {
        "path": "package-lock.json",
        "format": "npm-lock",
        "value": "package",
        "package": "ottplay-swop"
      }
    ],
    "artifacts": [
      {
        "path": "ottplay-swop-worker.tar.gz",
        "format": "tar-json",
        "value": "package",
        "member": "build-info.json",
        "field": "version"
      }
    ],
    "toolkit_revision": "9dd211aa50a9ae8442b03539570caddc7329408b"
  },
  "single_entry_ci": true,
  "change_scope": {
    "documentation_paths": [],
    "required_paths": [],
    "always_validate_workflows": [
      "codeql.yml"
    ]
  },
  "release_notes": "CHANGELOG.md"
}
