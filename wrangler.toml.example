# Copy to wrangler.toml (gitignored) for local wrangler dev/tail.
# Production Worker script deploy is owned by Terraform (see README Infrastructure).
# Never commit wrangler.toml with real account/KV ids or secrets.

name = "ottplay-swop"
main = "src/index.ts"
compatibility_date = "2025-09-01"

# account_id = "YOUR_CLOUDFLARE_ACCOUNT_ID"

[[kv_namespaces]]
binding = "SWOP"
id = "YOUR_KV_NAMESPACE_ID"

[vars]
PUBLIC_BASE_URL = "https://swop.2560801.xyz"
SESSION_TTL_SECONDS = "600"

# ADMIN_TOKEN: for local/dev you may still use:
#   wrangler secret put ADMIN_TOKEN
# Production: set TFC sensitive var admin_token, or leave unset so Terraform
# keep_bindings preserves the existing secret_text binding on updates.
