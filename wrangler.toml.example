# Copy to wrangler.toml (gitignored) for local wrangler dev/tail.
# Production Worker script deploy is owned by Terraform (see README Infrastructure).
# Never commit wrangler.toml with real account/KV ids or secrets.

name = "ottplay-swop"
main = "src/index.ts"
compatibility_date = "2025-09-01"
# Account settings belong to the root, before any TOML table.
# account_id = "YOUR_CLOUDFLARE_ACCOUNT_ID"

[[durable_objects.bindings]]
name = "SESSIONS"
class_name = "SwopSession"

[[migrations]]
tag = "swop-sessions-v1"
new_sqlite_classes = ["SwopSession"]

[[ratelimits]]
name = "REQUEST_RATE_LIMIT"
namespace_id = "1001"
simple = { limit = 240, period = 60 }

[[kv_namespaces]]
binding = "SWOP"
id = "YOUR_KV_NAMESPACE_ID"

[vars]
PUBLIC_BASE_URL = "https://swop.2560801.xyz"
SESSION_TTL_SECONDS = "600"
# Exact canonical HTTP(S) API URLs; empty disables the VPortal relay.
VPORTAL_ENDPOINTS_JSON = "[]"

# ADMIN_TOKEN: for local/dev you may still use:
#   wrangler secret put ADMIN_TOKEN
# Production: set TFC sensitive var admin_token, or leave unset so Terraform
# keep_bindings preserves the existing secret_text binding on updates.

# INSTALLATION_CREDENTIALS_JSON: secret [{id, token, origins}] for trusted
# player-host backends. Generate independent 256-bit tokens per installation.
#   wrangler secret put INSTALLATION_CREDENTIALS_JSON
# Production: set sensitive TFC variable installation_credentials_json.
# Never put this secret in [vars], static player files, or browser storage.
