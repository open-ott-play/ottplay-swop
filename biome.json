{
  "$schema": "https://biomejs.dev/schemas/2.4.16/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "ignoreUnknown": false,
    "includes": ["src/**", "vitest.config.ts", "*.ts"]
  },
  "formatter": { "enabled": true, "formatWithErrors": false, "indentStyle": "space", "indentWidth": 2, "lineWidth": 100 },
  "linter": { "enabled": true, "rules": { "recommended": true, "correctness": { "noUnusedVariables": "error" } } },
  "javascript": { "formatter": { "quoteStyle": "double", "semicolons": "always", "trailingCommas": "es5" } },
  "assist": { "enabled": true, "actions": { "source": { "organizeImports": "on" } } }
}